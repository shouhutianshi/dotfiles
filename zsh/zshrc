# 从剪贴板粘贴图片，保存到临时文件并输出路径
paste-image() {
    local tmpfile="/tmp/clipboard_image.png"
    if pngpaste "$tmpfile" 2>/dev/null; then
        echo "✅ $tmpfile"
        echo "$tmpfile" | pbcopy  # 复制路径到剪贴板
        imgcat "$tmpfile" 2>/dev/null  # 在终端显示图片
        echo "📋 路径已复制，Cmd+V 粘贴到对话框"
    else
        echo "❌ 剪贴板中没有图片" >&2
        return 1
    fi
}

# 快速创建新标签页/窗口
newtab() {
    local cmd="$*"
    osascript >/dev/null <<EOF
tell application "iTerm"
    tell current window
        create tab with default profile
        tell current session
            write text "${cmd:-$PWD}"
        end tell
    end tell
end tell
EOF
}

newwin() {
    local cmd="$*"
    osascript >/dev/null <<EOF
tell application "iTerm"
    create window with default profile
    tell current session
        write text "${cmd:-$PWD}"
    end tell
end tell
EOF
}

# ===== 开发工具快捷函数 =====

# 快速查找并打开文件
fe() {
    local files
    IFS=$'\n' files=($(fzf-tmux --query="$1" --multi --select-1 --exit-0))
    [[ -n "$files" ]] && ${EDITOR:-vim} "${files[@]}"
}

# 快速切换目录
fd() {
    local dir
    dir=$(find ${1:-.} -path '*/\.*' -prune -o -type d -print 2>/dev/null | fzf +m) && cd "$dir"
}

# 使用 rg 搜索并预览
fzf_search() {
    rg --color=always --line-number --no-heading "$@" |
      fzf --ansi \
          --color "hl:-1:underline,hl+:-1:underline:reverse" \
          --delimiter : \
          --preview 'bat --color=always {1} --highlight-line {2}' \
          --preview-window 'up,60%,border-bottom,+{2}+3/3,~3' \
          --bind 'enter:become(vim {1} +{2})'
}

# Git 增强功能
git_show() {
    git log --graph --color=always \
        --format="%C(auto)%h%d %s %C(black)%C(bold)%cr" "$@" |
    fzf --ansi --no-sort --reverse --tiebreak=index \
        --bind 'ctrl-s:toggle-sort,ctrl-m:execute:
                echo "{}" | grep -o "[a-f0-9]\{7,\}" |
                xargs -I % sh -c "git show --color=always % | less -R"'
}

