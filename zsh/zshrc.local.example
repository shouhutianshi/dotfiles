# ~/.zshrc.local 示例文件
# 将此文件复制到 ~/.zshrc.local 并填入你的真实信息

# ===== 敏感信息（不要提交到 git） =====

# 内部账号
# export INTERNAL_ACCOUNT="your_username"
# export INTERNAL_SECRET="your_password"

# Google Cloud
# export GOOGLE_CLOUD_PROJECT="your-project-id"

# API Keys
# export ZAI_API_KEY="your_api_key"

# SSH 快捷登录
# alias remote="sshpass -p 'your_password' ssh user@host"

# Volta
# export VOLTA_HOME="$HOME/.volta"
